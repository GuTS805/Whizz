# Server-only: private key of a funded testnet wallet that pays gas for new users.
# Use a throwaway wallet. NEVER prefix with NEXT_PUBLIC_ (that would leak it to browsers).
FAUCET_PRIVATE_KEY=0x...

# MON sent to each new user (default 0.1)
DRIP_AMOUNT=0.1

# Optional: custom Monad testnet RPC
# NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
